# Copy to .env.local for local dev, and add the same keys in Vercel -> Project -> Settings -> Environment Variables.
# Leave both empty to run in local demo mode (data kept in the browser only).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show the "AS" persona switcher even when Supabase sign-in is on (testing only).
# VITE_ENABLE_PERSONA_SWITCH=true
